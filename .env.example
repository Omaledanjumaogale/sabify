# Sabify environment
# Public values are exposed to the browser. Never put secrets in PUBLIC_* vars.

# Convex deployment (run `npx convex dev` to create one)
PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud
CONVEX_DEPLOYMENT=dev:your-deployment

# Paystack (server-side webhook verification only)
PAYSTACK_SECRET_KEY=sk_test_xxx
PAYSTACK_WEBHOOK_SECRET=whsec_xxx

# Site
PUBLIC_SITE_URL=https://sabify.pages.dev
